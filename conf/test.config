// Quick smoke test on two small chromosomes with modest resources.
params {
    chroms        = '21,22'
    max_cpus      = 8
    max_memory    = '32 GB'
    max_time      = '12h'
    read_phaser   = 'whatshap,longphase'
    pop_phaser    = 'shapeit4,beagle'
}

process.resourceLimits = [cpus: 8, memory: 32.GB, time: 12.h]
