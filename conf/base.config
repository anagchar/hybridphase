process {
    cpus   = { 2 }
    memory = { 8.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    container = params.phasing_container

    withLabel: 'clair3' {
        container = params.clair3_container
        cpus      = { 48 }
        memory    = { 128.GB * task.attempt }
        time      = { 72.h * task.attempt }
    }
    withLabel: 'dipcall' {
        container = params.dipcall_container
        cpus      = { 48 }
        memory    = { 128.GB * task.attempt }
        time      = { 48.h * task.attempt }
    }
    withLabel: 'asm_map' {
        cpus   = { 32 }
        memory = { 64.GB * task.attempt }
        time   = { 72.h * task.attempt }
    }
    withName: 'ASM_TAG|HIPHAP' {
        memory = { 48.GB * task.attempt }
    }
    withLabel: 'phase' {
        cpus   = { 4 }
        memory = { 16.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'pop' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'haplotag' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 72.h * task.attempt }
    }
    withLabel: 'light' {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'REPORT' {
        memory = { 32.GB * task.attempt }
    }
}
