// VSC (KU Leuven) mindwell cluster, bigmem partition — adjust account/partition to your allocation.
params {
    max_cpus   = 48
    max_memory = '1000.GB'
    max_time   = '7.d'
}

process {
    executor       = 'slurm'
    queue          = 'dedicated_big_bigmem'
    clusterOptions = '--account=lp_big_mindwell_cpu --clusters=mindwell'
}

executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('VSC_SCRATCH') ?: '.'}/singularity_cache"
    runOptions = (['-B /gpfs1/project/prj_00009'] + (params.extra_binds ? params.extra_binds.tokenize(',').collect { "-B ${it}" } : [])).join(' ')
}
