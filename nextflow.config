/*
 * hybridphase: Clair3 -> read-based + population-based (hybrid) phasing -> haplotagging -> report
 */

manifest {
    name            = 'hybridphase'
    description     = 'Hybrid read-based (WhatsHap / LongPhase) + population-based (SHAPEIT4 / Beagle) phasing of long-read data'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    // ---------------- input ----------------
    sample            = 'SAMPLE'
    bam               = null          // coordinate-sorted, indexed BAM (.bai or .csi next to it)
    ref               = null          // reference FASTA (.fai next to it)
    vcf               = null          // optional: existing Clair3 VCF -> Clair3 is skipped
    barcodes          = null          // optional: cell barcodes (first column) -> cellsnp-lite + ASCAT.sc tables
    outdir            = 'results'
    drop_duplicates   = true          // remove 0x400-flagged reads before Clair3 / phasing (lrsinglecell flags, does not remove)

    // ---------------- variant calling (Clair3) ----------------
    platform          = 'ont'         // ont | hifi
    clair3_model_dir  = null          // directory that contains the model, e.g. .../clair3_models
    clair3_model      = 'r1041_e82_400bps_sup_v520'
    clair3_args       = ''            // extra Clair3 arguments

    // ---------------- germline het SNP filter ----------------
    min_qual          = 20
    min_dp            = 15
    min_vaf           = 0.25
    max_vaf           = 0.75

    // ---------------- phasing ----------------
    chroms            = '1-22'        // e.g. '1-22', '21,22', '1-5,X'
    chr_prefix        = 'chr'
    read_phaser       = 'whatshap'    // whatshap | longphase | comma-separated list to run several
    pop_phaser        = 'shapeit4'    // shapeit4 | beagle | none | comma-separated list
    hybrid_merge      = 'orient'      // orient: flip whole read blocks to the population phase (keeps the read phaser's blocks)
                                      // whatshap: re-run WhatsHap with reads + population VCF as pseudo-read
    orient_min_snps   = 2             // min. SNPs shared with the population phase to orient (join) a read block
    shapeit4_use_ps   = 0.001         // SHAPEIT4 --use-PS error rate
    shapeit4_args     = '--sequencing'
    beagle_args       = ''

    // reference panel / genetic maps. Default: the copies baked into containers/hybridphase.def
    // {chr} is replaced by the chromosome name (e.g. chr22)
    panel_dir         = '/opt/ref_data/1000G_phase3_hg38'
    panel_name        = '1kGP_phase3_{chr}.bcf'
    map_dir           = '/opt/ref_data/genetic_maps'
    map_name          = '{chr}.b38.gmap.gz'         // SHAPEIT4 format (pos chr cM); converted to PLINK for Beagle
    beagle_panel_dir  = null          // optional pre-made Beagle panels (vcf.gz or bref3); default: convert the BCF on the fly
    beagle_panel_name = '{chr}.bref3'

    // ---------------- QC ----------------
    junction_test     = true          // truth-free masking test of how well the population phaser joins read blocks
    junction_min_snps = 10

    // ---------------- optional truth benchmark ----------------
    // haplotype-resolved diploid assembly of the same individual (two FASTAs) -> dipcall truth
    hap1              = null
    hap2              = null
    dipcall_args      = ''            // e.g. '-x hs38.PAR.bed' for a male sample
    assembly_truth    = true          // with --hap1/--hap2: dipcall truth + WhatsHap compare of every phased VCF
    assembly_haplotag = true          // with --hap1/--hap2: haplotag reads by mapping them to hap1 + hap2
    asm_min_diff      = 6             // min. alignment-score difference hap1 vs hap2 to assign a read (~1 het SNV)
    asm_keep_tags     = 'CB,UB'       // read tags carried over to the assembly alignments
    asm_minimap2_args = ''
    // or an existing truth VCF (phased GT) + confident-region BED (dipcall is skipped)
    truth_vcf         = null
    truth_bed         = null

    // ---------------- haplotagging ----------------
    haplotag          = true
    haplotag_tool     = 'whatshap'    // whatshap | longphase
    haplotag_combo    = null          // which <read>_<pop> result to haplotag; default: the first combination
    haplotag_bin_mb   = 1             // bin size for the H1/H2 read-fraction plot

    // ---------------- containers ----------------
    clair3_container  = 'docker://hkubal/clair3:v2.0.0'
    dipcall_container = 'docker://quay.io/biocontainers/dipcall:0.3--hdfd78af_0'
    phasing_container = 'hybridphase.sif'   // build from containers/hybridphase.def
    extra_binds       = ''            // comma-separated host paths to bind into containers (e.g. external panel_dir)

    // ---------------- resources (max) ----------------
    max_cpus          = 48
    max_memory        = '1000.GB'
    max_time          = '7.d'
}

includeConfig 'conf/base.config'

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = params.extra_binds ? params.extra_binds.tokenize(',').collect { "-B ${it}" }.join(' ') : ''
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.runOptions = params.extra_binds ? params.extra_binds.tokenize(',').collect { "-B ${it}" }.join(' ') : ''
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    slurm {
        process.executor = 'slurm'
    }
    // VSC KU Leuven, wICE/mindwell bigmem
    vsc_mindwell {
        includeConfig 'conf/vsc_mindwell.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

def check_max(obj, type) {
    if (type == 'memory') {
        def max = params.max_memory as nextflow.util.MemoryUnit
        return obj.compareTo(max) == 1 ? max : obj
    } else if (type == 'time') {
        def max = params.max_time as nextflow.util.Duration
        return obj.compareTo(max) == 1 ? max : obj
    } else if (type == 'cpus') {
        return Math.min(obj as int, params.max_cpus as int)
    }
    return obj
}
